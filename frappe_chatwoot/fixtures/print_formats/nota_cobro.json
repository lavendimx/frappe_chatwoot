    "raw_printing": 0,
    "html": "<style>\n  .ncb-wrap { font-family: Arial, Helvetica, sans-serif; color: #1f2937; font-size: 12px; }\n  .ncb-head { width: 100%; border-bottom: 2px solid #6c2bd9; padding-bottom: 10px; margin-bottom: 16px; border-collapse: collapse; }\n  .ncb-head td { vertical-align: middle; }\n  .ncb-logo { height: 46px; }\n  .ncb-title { text-align: right; font-size: 20px; font-weight: bold; letter-spacing: 1px; color: #111827; }\n  .ncb-sub { text-align: right; font-size: 11px; color: #6b7280; }\n  .ncb-meta { width: 100%; border-collapse: collapse; margin-bottom: 16px; }\n  .ncb-meta td { border: 1px solid #e5e7eb; padding: 6px 8px; vertical-align: top; }\n  .ncb-meta td.k { background: #f9fafb; color: #6b7280; width: 18%; font-weight: bold; }\n  .ncb-items { width: 100%; border-collapse: collapse; margin-bottom: 14px; }\n  .ncb-items th { background: #6c2bd9; color: #ffffff; padding: 7px 8px; font-size: 11px; text-align: left; border: 1px solid #6c2bd9; }\n  .ncb-items td { border: 1px solid #e5e7eb; padding: 6px 8px; }\n  .ncb-items td.num, .ncb-items th.num { text-align: right; white-space: nowrap; }\n  .ncb-tot { width: 100%; border-collapse: collapse; }\n  .ncb-tot td { border: 1px solid #e5e7eb; padding: 6px 8px; }\n  .ncb-tot td.k { text-align: right; color: #374151; }\n  .ncb-tot td.v { text-align: right; white-space: nowrap; }\n  .ncb-tot tr.total td { background: #f3e8ff; font-weight: bold; font-size: 13px; color: #111827; }\n  .ncb-note { margin-top: 16px; border: 1px solid #e5e7eb; border-left: 4px solid #6c2bd9; background: #faf7ff; padding: 10px 12px; }\n  .ncb-note h4 { margin: 0 0 6px 0; font-size: 12px; color: #6c2bd9; text-transform: uppercase; letter-spacing: .5px; }\n  .ncb-note p { margin: 0; }\n  .ncb-void { border: 2px solid #dc2626; color: #dc2626; font-weight: bold; text-align: center; padding: 6px; margin-bottom: 12px; }\n  .ncb-foot { margin-top: 22px; padding-top: 8px; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 10px; text-align: center; }\n</style>\n<div class=\"ncb-wrap\">\n  {% if doc.docstatus == 2 %}<div class=\"ncb-void\">DOCUMENTO CANCELADO</div>{% endif %}\n  <table class=\"ncb-head\"><tr>\n    <td style=\"width: 55%;\">\n      <img class=\"ncb-logo\" src=\"https://lavendi.mx/wp-content/uploads/2020/08/logo-lavendi.mx_-e1596934014832.png\" alt=\"lavendi.mx\">\n    </td>\n    <td style=\"width: 45%;\">\n      <div class=\"ncb-title\">NOTA DE COBRO</div>\n      <div class=\"ncb-sub\">{{ doc.get(\"company\") or \"lavendi.mx\" }}</div>\n    </td>\n  </tr></table>\n\n  <table class=\"ncb-meta\">\n    <tr>\n      <td class=\"k\">Documento</td><td>{{ doc.name }}</td>\n      <td class=\"k\">Fecha de emision</td><td>{{ doc.get_formatted(\"posting_date\") }}</td>\n    </tr>\n    <tr>\n      <td class=\"k\">Cliente</td><td>{{ doc.customer_name or doc.customer }}</td>\n      <td class=\"k\">Fecha limite</td><td>{% if doc.get(\"due_date\") %}{{ doc.get_formatted(\"due_date\") }}{% else %}&mdash;{% endif %}</td>\n    </tr>\n    {% if doc.get(\"po_no\") %}<tr><td class=\"k\">Referencia</td><td colspan=\"3\">{{ doc.po_no }}</td></tr>{% endif %}\n    {% if doc.get(\"address_display\") %}<tr><td class=\"k\">Domicilio</td><td colspan=\"3\">{{ doc.address_display | replace(\"\\n\", \"<br>\") }}</td></tr>{% endif %}\n  </table>\n\n  <table class=\"ncb-items\">\n    <thead><tr>\n      <th style=\"width: 6%;\">#</th>\n      <th>Concepto</th>\n      <th class=\"num\" style=\"width: 10%;\">Cant.</th>\n      <th style=\"width: 10%;\">Unidad</th>\n      <th class=\"num\" style=\"width: 16%;\">P. unitario</th>\n      <th class=\"num\" style=\"width: 16%;\">Importe</th>\n    </tr></thead>\n    <tbody>\n    {% for row in doc.items %}\n      <tr>\n        <td>{{ row.idx }}</td>\n        <td>{{ row.item_name }}{% if row.get(\"description\") and row.description != row.item_name %}<br><span style=\"color: #6b7280;\">{{ row.description }}</span>{% endif %}</td>\n        <td class=\"num\">{{ row.get_formatted(\"qty\") }}</td>\n        <td>{{ row.get(\"uom\") or \"\" }}</td>\n        <td class=\"num\">{{ row.get_formatted(\"rate\") }}</td>\n        <td class=\"num\">{{ row.get_formatted(\"amount\") }}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n  </table>\n\n  <table style=\"width: 100%; border-collapse: collapse;\"><tr>\n    <td style=\"width: 52%; border: none; padding: 0;\"></td>\n    <td style=\"border: none; padding: 0;\">\n      <table class=\"ncb-tot\">\n        <tr><td class=\"k\">Subtotal</td><td class=\"v\">{{ doc.get_formatted(\"net_total\") }}</td></tr>\n        {% for t in doc.taxes %}\n        <tr><td class=\"k\">{{ t.description }}{% if t.rate %} ({{ t.rate }}%){% endif %}</td><td class=\"v\">{{ t.get_formatted(\"tax_amount\") }}</td></tr>\n        {% endfor %}\n        <tr class=\"total\"><td class=\"k\">Total</td><td class=\"v\">{{ doc.get_formatted(\"grand_total\") }}</td></tr>\n        {% if doc.docstatus == 1 %}<tr><td class=\"k\">Saldo pendiente</td><td class=\"v\">{{ doc.get_formatted(\"outstanding_amount\") }}</td></tr>{% endif %}\n      </table>\n    </td>\n  </tr></table>\n\n  {% if doc.get(\"in_words\") %}<p style=\"margin-top: 8px; font-size: 11px; color: #374151;\"><b>Importe con letra:</b> {{ doc.in_words }}</p>{% endif %}\n\n  <div class=\"ncb-note\">\n    <h4>Nota de cobro</h4>\n    <p>Le recordamos amablemente el pago correspondiente al documento <b>{{ doc.name }}</b>{% if doc.get(\"due_date\") %}, con fecha limite <b>{{ doc.get_formatted(\"due_date\") }}</b>{% endif %}. Agradecemos realizar el pago dentro del plazo indicado. Para cualquier aclaracion sobre esta nota, contactenos y con gusto le atenderemos.</p>\n    {% if doc.get(\"terms\") %}<p style=\"margin-top: 6px;\">{{ doc.terms }}</p>{% endif %}\n  </div>\n\n  <div class=\"ncb-foot\">lavendi.mx &middot; contacto@lavendi.mx &middot; Gracias por su preferencia.</div>\n</div>",
