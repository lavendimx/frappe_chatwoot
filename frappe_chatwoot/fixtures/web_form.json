  "button_label": "SOLICITAR COTIZACIÓN",
  "client_script": "\nfrappe.ready(function () {\n  const p = new URLSearchParams(window.location.search);\n  const mapa = {\n    utm_source: 'utm_source', utm_medium: 'utm_medium',\n    utm_campaign: 'utm_campaign', utm_term: 'utm_term', utm_content: 'utm_content',\n    gclid: 'gclid', gbraid: 'gbraid', wbraid: 'wbraid',\n  };\n  for (const [param, campo] of Object.entries(mapa)) {\n    const v = p.get(param);\n    if (v) { frappe.web_form.set_value(campo, v.slice(0, 140)); }\n  }\n  const pagina = p.get('pagina') || document.referrer || '';\n  if (pagina) { frappe.web_form.set_value('pagina_origen', pagina.slice(0, 140)); }\n});\n",
  "condition_json": null,
  "crm_hidden_defaults": null,
  "crm_published": 0,
  "custom_css": "\n/* El formulario vive dentro de un iframe en una sección de lavendi.mx que ya\n   trae su propio encabezado y fondo: aquí sobra todo el chrome del sitio\n   Frappe (navbar, footer, título, card). */\nnav.navbar, footer, .web-footer, .footer-logo-extension,\n.web-form-container .title, .web-form-header, .web-form-head,\n.web-form-wrapper .page-header-actions-block,\n.web-form-wrapper .form-breadcrumbs, .navbar-expand-lg { display: none !important; }\n\nhtml, body { background: transparent !important; }\nbody { font-family: Inter, -apple-system, \"Segoe UI\", sans-serif !important; }\nmain.container, main.container.my-4, .page_content {\n  padding: 0 !important; margin: 0 !important; max-width: 100% !important;\n}\n.page-content-wrapper { min-height: 0 !important; }\n.web-form-container, form.web-form, .web-form-body, .web-form-wrapper,\n.form-layout, .form-page {\n  background: transparent !important; border: none !important;\n  box-shadow: none !important; padding: 0 !important; margin: 0 !important;\n  max-width: 100% !important;\n}\n.web-form-wrapper .form-section, .form-section {\n  border: none !important; padding: 0 !important; margin: 0 0 4px !important;\n  background: transparent !important;\n}\n.section-body, .form-column, .form-column.col-sm-12 { padding: 0 !important; }\n.form-section .section-head, .section-head {\n  color: #2c3345 !important; font-size: 14px !important; font-weight: 500 !important;\n  text-transform: none !important; letter-spacing: 0 !important;\n  padding: 18px 0 6px !important; border: none !important; margin: 0 !important;\n}\n.control-label {\n  color: #2c3345 !important; font-size: 14px !important; font-weight: 500 !important;\n  margin-bottom: 4px !important;\n}\n.frappe-control { margin-bottom: 14px !important; }\ninput.form-control, textarea.form-control, select.form-control,\n.input-with-feedback.form-control {\n  border: none !important; border-bottom: 1px solid #d8dde8 !important;\n  border-radius: 0 !important; background: transparent !important;\n  padding: 8px 0 !important; font-size: 14px !important; color: #2c3345 !important;\n  box-shadow: none !important; font-weight: 400 !important; height: auto !important;\n}\ninput.form-control:focus, textarea.form-control:focus {\n  border-bottom-color: #6c2bd9 !important; box-shadow: none !important;\n  background: transparent !important;\n}\ninput.form-control::placeholder { color: #adbde7 !important; font-size: 12px !important; }\n.help-box, .form-text, small.form-text {\n  color: #8c8c8c !important; font-size: 12px !important; margin-top: 2px !important;\n}\n.checkbox { margin-bottom: 10px !important; }\n.checkbox .label-area {\n  color: #2c3345 !important; font-size: 14px !important; font-weight: 400 !important;\n}\n.checkbox input[type=checkbox] {\n  accent-color: #6c2bd9 !important; width: 16px !important; height: 16px !important;\n}\n/* El botón de enviar vive en `.web-form-footer > .web-form-actions >\n   .right-area`, que es flex-end: sin estirar esa cadena el CTA queda chico y\n   pegado a la derecha, no como el botón de ancho completo que el sitio tenía. */\n.web-form-footer, .footer-cta, .web-form-actions, .right-area, .left-area {\n  justify-content: stretch !important; margin-top: 0 !important;\n  padding: 0 !important; border: none !important; background: transparent !important;\n}\n.web-form-footer { margin-top: 20px !important; }\n.web-form-actions { display: flex !important; width: 100% !important; }\n.right-area { flex: 1 1 auto !important; display: block !important; }\n.left-area { display: none !important; }\n.submit-btn, .btn-primary, button[type=submit] {\n  background: #6c2bd9 !important; border-color: #6c2bd9 !important;\n  width: 100% !important; border-radius: 6px !important; padding: 14px !important;\n  font-size: 15px !important; font-weight: 600 !important; letter-spacing: .04em !important;\n  text-transform: uppercase !important; margin: 0 !important;\n}\n.submit-btn:hover, .btn-primary:hover {\n  background: #5a22b8 !important; border-color: #5a22b8 !important;\n}\n.btn-secondary, .btn-default, #discard, .comment-box, .footer-addon,\n.web-form-actions .btn-secondary { display: none !important; }\n\n/* Va al final a propósito: la regla de arriba pone `padding: 0` sobre\n   `form.web-form` junto con el resto de contenedores, y entre dos reglas\n   `!important` gana la última. El respiro lateral hace falta porque el iframe\n   va a ras del borde de la columna Kadence. */\nform.web-form { padding: 2px 14px 0 !important; }\n.frappe-control { margin-bottom: 6px !important; }\n.control-input-wrapper { margin-top: -2px !important; }\n",
